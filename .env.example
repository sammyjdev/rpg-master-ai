# Copy to .env (gitignored) and fill per-machine values for the GNOMON eval glue.
# infra/scripts/gnomon_batch_two_judges.py reads these; unset falls back to localhost.

# Ollama judge host (default: http://localhost:11434)
JUDGE_URL=

# Target model server the eval hits (default: http://localhost:8082/v1)
TARGET_URL=
